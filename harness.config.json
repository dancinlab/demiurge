{
  "project": "demiurge",
  "profile": "hardcore",
  "stack": [],
  "lockdown": {
    "files": [
      "bin/demiurge",
      "cli/demiurge_cli.hexa",
      "web/middleware.ts"
    ],
    "fromMarkdown": "CLAUDE.md",
    "onEditReminder": "L0 file edited \u2014 update CHANGELOG + issue tracker in the same change."
  },
  "enforcementFile": ".harness/enforcement.json",
  "keywordsFile": ".harness/keywords.json",
  "severityMapFile": ".harness/severity-map.json",
  "verify": {
    "checks": []
  },
  "lint": {
    "freshnessFiles": [],
    "changelog": {
      "file": "CHANGELOG.md",
      "triggerPattern": "\\.(ts|tsx|js|jsx|py|rb|go|rs|java|kt|c|h|cpp|cc|hpp|m|mm|swift|hexa)$",
      "ignore": [
        "(^|/)(tests?|__tests__|spec)/",
        "\\.(test|spec)\\.[a-z]+$",
        "(^|/)\\.harness(-engine)?/"
      ]
    },
    "protectedBranches": [
      "main",
      "master"
    ]
  },
  "guides": [
    "CLAUDE.md",
    "AGENTS.md",
    "README.md"
  ],
  "docs": {
    "enforce": "warn",
    "architecture": "ARCHITECTURE.json",
    "log": "CHANGELOG.md",
    "scratchDir": "state",
    "scopeDirs": [
      ""
    ],
    "allow": [
      "README.md",
      "CHANGELOG.md",
      "ARCHITECTURE.json",
      "ARCHITECTURE.html",
      "CLAUDE.md",
      "AGENTS.md",
      "LICENSE",
      "CONTRIBUTING.md",
      "SECURITY.md",
      "DOMAIN_AUDIT.md",
      "MAIN.md"
    ]
  },
  "ledger": {
    "staleSec": 1800
  }
}
