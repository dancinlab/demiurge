#!/usr/bin/env bash
# demiurge — hx package entry point (hx convention: <pkg>/bin/<name>).
# Installed via `hx install /Users/mini/dancinlab/demiurge`, then reachable
# as `demiurge <subcommand>` through the hx shim.
#
# The macOS SwiftUI cockpit GUI was scrapped — the user surface is now
# the web GUI (Next.js · Cloud Run, demiurge.dancinlab.org). Swift is
# CLI-only; this shim is the headless / AI-agent surface.
#
#   demiurge cli <args...>          hexa-native CLI (list-records / show / …)
#   demiurge                        this help
#
# The legacy Swift DemiurgeCLI was DELETED in the hexa-native migration
# (8VERB stack #28). `cli --swift` / DEMIURGE_CLI=swift now hard-error;
# hexa-native is the only CLI path.
set -euo pipefail

# Resolve through the hx shim symlink chain (~/.hx/bin/demiurge →
# ~/.hx/packages/demiurge/bin/demiurge, and the packages/demiurge dir
# is itself a symlink to the real repo) so REPO is the actual checkout.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
REPO="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

# Installed hexa-native demi CLI. Default path = hexa (per @L5: full per-verb
# parity met). Derive the stdlib home from $HOME (NOT a hardcoded user-absolute
# path); DEMIURGE_HEXA_STDLIB overrides it for non-standard installs. There is
# no `hexa demi` subcommand and `hexa run` resolves relative paths against cwd,
# so an absolute install path is required for cwd-independence.
DEMI_CLI="${DEMIURGE_HEXA_STDLIB:-$HOME/hexa-sh/stdlib/demi}/demi_cli.hexa"

case "${1:-}" in
  cli)
    shift
    # Legacy Swift fallback RETIRED — the Swift DemiurgeCLI was deleted in the
    # hexa-native migration (8VERB stack #28). `cli --swift` / DEMIURGE_CLI=swift
    # would `swift run` a target that no longer exists, so hard-error instead of
    # a confusing build failure. hexa-native is now the only CLI path.
    if [ "${1:-}" = "--swift" ] || [ "${DEMIURGE_CLI:-}" = "swift" ]; then
      echo "demiurge cli: --swift removed — Swift CLI deleted in the hexa-native migration (see 8VERB); hexa-native is now the only path" >&2
      exit 2
    fi
    # Default (and only) path: the installed hexa-native CLI (cwd-independent via $DEMI_CLI).
    exec hexa run "$DEMI_CLI" "$@"
    ;;
  ""|-h|--help|help)
    cat <<'USAGE'
demiurge — universal hexa-native technical-design architecture program

  demiurge cli <args...>          hexa-native CLI (list-records / list-decisions
                                  / list-rfcs / list-domains / show <path> / …)
  demiurge --help                 this help

The CLI is the hexa-native demi CLI (hexa-lang stdlib/demi) — the only path.
The legacy Swift DemiurgeCLI was deleted in the hexa-native migration (8VERB
stack #28); `cli --swift` / DEMIURGE_CLI=swift now hard-error. Set
DEMIURGE_HEXA_STDLIB to override the stdlib home.

The user surface is the web GUI (Next.js · Cloud Run); the CLI is the
AI-agent + web-bridge surface (design.md D34). The macOS SwiftUI cockpit
was scrapped.
USAGE
    ;;
  *)
    echo "demiurge: unknown subcommand '$1' — try 'demiurge --help'" >&2
    exit 2
    ;;
esac
