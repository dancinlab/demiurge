@V := "discovery" :: log
@seed := "AGA-CURE validated a reusable method: reversibility-gradient follicle-class
decomposition → in-silico design-axis collapse → reduction to ONE measurable parameter
(E_max) + closed-negative falsifications. What other chronic-degenerative cure targets
does this transfer to, and what new demiurge primitives does it spawn?"

# ── candidate next directions (id · seed · verdict-tier-target) ──

@X cure-axis-collapse-primitive := "generalize the axis-collapse method into a demiurge
  domain-design PRIMITIVE — any chronic degenerative with (a) a reversibility gradient,
  (b) a neogenesis frontier, (c) a permanence requirement maps to the same 4-arm + DCx
  reduction. Ship as a reusable template (deck/dojo-style generator)."
  tier-target = "🔵 method formalization + 1 cross-domain reuse demonstration"
  reuse[AGA-CURE]

@X periodontal-regen-cure := "alveolar bone + periodontal ligament regeneration cure.
  Same structure: reversible (gingival recession) vs fibrosed (lost ligament/bone) classes;
  Wnt/BMP neogenesis; the gate likely collapses to osteoblast/cementoblast neogenesis
  efficiency. NOVEL non-surgical disease-modifying target."
  tier-target = "🟢 axis-collapse to a single in-vitro-measurable (osteo-neogenesis η)"
  reuse[AGA-CURE arm4-neogenesis · DC8-turing-spacing]

@X OA-cartilage-cure := "osteoarthritis cartilage regeneration. Chondrocyte reactivation
  (reversible) + chondral neogenesis (fibrosed). Avascular tissue → delivery is the binding
  axis (analog of DC7). Gate likely collapses to chondrocyte-neogenesis efficiency + load-bearing
  matrix maturation."
  tier-target = "🟢 axis-collapse + identify the binding axis (delivery vs neogenesis)"
  reuse[AGA-CURE DC7-delivery · DC3-permanence]

@X retinal-photoreceptor-cure := "dry-AMD / RP photoreceptor restoration. Müller-glia
  reprogramming (reactivation) + photoreceptor neogenesis. Permanence via epigenetic lock
  (DC3/DC12 transfer). Gate collapses to glia→photoreceptor conversion efficiency."
  tier-target = "🟢 axis-collapse + DC12 fidelity transfer to a post-mitotic niche"
  reuse[AGA-CURE DC3-epigenetic · DC12-heritability]

@X novel-senolytic-AGA-adjacent := "the senolytic prep-only arm (DC3) → a standalone NOVEL
  senolytic-drug domain for the fibrosed-niche clearance step shared across ALL the above
  (clear senescent fibroblasts to RE-OPEN the neogenesis window — lifts the η_neo bottleneck
  DC14 flagged)."
  tier-target = "💊 NOVEL drug domain — docking + ADMET + the η_neo-lift hypothesis"
  reuse[AGA-CURE DC14-bottleneck · AGA-RX docking-stack]

