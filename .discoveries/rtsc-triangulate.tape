@V := "discovery" :: rtsc-triangulate [active]
  date      = "2026-06-08"
  domain    = "RTSC"
  seed      = "Reserve DAYS-long DFPT el-ph (Li2MgH16 anchor) for only the candidates that score high across MANY INDEPENDENT cheap bearings — like GPS satellites, k independent bearings shrink the consensus variance ~1/k. Build an N-dim independence-weighted consensus screen + a PCA effective-dimension honesty check."
  method    = "RTSC-TRIANGULATE: 4 cheap composition bearings (A=omega_log stiffness from masses; B=N(E_F).H-character stoich proxy; C=covalent H-network connectivity; D=descriptor-McMillan-Tc surrogate) z-normalized + fused by independence-weighted consensus (w_b ~ 1/sum|corr|). Independence MEASURED via Pearson-corr-matrix Jacobi eigendecomposition -> participation-ratio effective_dim. Generic d4 contract: a bearing = a named column; adding one is a one-line manifest extension. Code: stdlib/rtsc/triangulate.hexa + triangulate_bearings.hexa. Run over 42 literature hydride formulas."
  mechanism = "k INDEPENDENT unbiased bearings of equal noise sigma fuse to variance ~sigma^2/k. PCA participation-ratio (Sum lambda)^2/Sum lambda^2 = effective # independent bearings; redundant bearings collapse it (warn) so the 1/k shrink is never over-sold. Independence weighting discounts shared information."
  bearings  = "A_omega (lattice-dyn) · B_nef (electronic) · C_connect (crystal-chem topology) · D_mltc (non-linear Tc-kernel fusion)"

# g5 GATE — green, numerical identities (no LLM judge)
@F f1 := "RTSC-TRIANGULATE fusion + PCA independence math verified; 21/21 checks PASS" :: verified [active]
  grade     = "GREEN SUPPORTED-NUMERICAL — hexa run stdlib/rtsc/triangulate_test.hexa = 'triangulate_selftest PASS' (21 checks). @ci_gate marked -> tool/stdlib_selftest_aggregate --ci-gate discovers it."
  identities = "z mean=0 & Sum z^2=n-1; redundant-pair+orthogonal -> effective_dim=1.8 EXACT (eigvals 2,1,0); 3 Hadamard-orthogonal -> effective_dim=3.0 EXACT (corr=I); independence weights down-weight redundant; superhydride consensus > non-hydride."
  provenance = "hexa-lang stdlib/rtsc/triangulate.hexa, triangulate_bearings.hexa, triangulate_test.hexa; reuses material/sim mcmillan_tc + inverse_variance_consensus (d19)."

# RUN — real 42-formula hydride set (composition-only, cheap regime)
@F f2 := "Ranked triangulated candidate list; known DFPT anchors land top-10 (sanity check)" :: verified [active]
  grade     = "GREEN RUN — hexa run stdlib/rtsc/triangulate_run.hexa over 42 literature hydride formulas."
  top10     = "1 CaH10  2 ScH9  3 MgH6  4 Li2MgH16(anchor)  5 SrH10  6 YH10  7 CaH6(anchor)  8 ScH6  9 YH9(anchor)  10 LaH10(anchor)"
  anchorcheck = "4 of the campaign's DFPT-confirmed anchors (Li2MgH16, CaH6, YH9, LaH10) all land in the top 10 -> ranking tracks known-good superhydrides. Conventional/molecular hydrides (SiH4, PH3, MgH2) + controls (NaCl, MgB2, CaC6) sink to the bottom."
  dft_targets = "NEXT el-ph targets = top-consensus NON-anchor valid candidates: CaH10 (#1), ScH9 (#2), MgH6 (#3), SrH10 (#5), YH10 (#6), ScH6 (#8). These are the triangulated intersection the expensive DFPT should be reserved for."

# HONEST limitation (d6) — surfaced BY the PCA check, not hidden — NOW BROKEN by f4
@F f3 := "On a composition-only DB the 4 PROXY bearings are largely redundant (effective_dim 1.51/4) — that screen is a RANKING HEURISTIC, not 4 independent measurements" :: honest-fence [superseded-by-f4]
  grade     = "WHITE SPECULATION-FENCED — the 1/k variance-shrink was only partly realized for the PROXY bearings; redundancy warning FIRES (effective_dim 1.51/4, max|off-diag corr| 0.94)."
  why       = "All 4 composition proxies ultimately read off H-fraction + cage-former propensity, so they correlate. The PCA honesty check is DOING ITS JOB by surfacing this rather than over-selling independence."
  breakthrough = "(d2) decorrelate by swapping each proxy for a REAL producer drawing on a DIFFERENT information source. IMPLEMENTED in f4 below: force-constant Debye ω (A), real-N(E_F) anchor table (B), real H-coordination (C), independent feature-basis Tc (D)."

# DECORRELATION RUN (d2 breakthrough) — bearing 탈상관, real-physics producers
@F f4 := "DECORRELATED bearings raise the MEASURED PCA effective_dim 1.51 -> 3.08/4 on the high-Tc superhydride family (n=21), clearing the redundancy warning — the 1/k variance-shrink now genuinely holds where the screen picks DFPT targets" :: verified [active]
  grade     = "GREEN SUPPORTED-NUMERICAL — hexa run stdlib/rtsc/triangulate_test.hexa = 'triangulate_selftest PASS' (68/68 checks incl. the new decorrelation gate); BEFORE/AFTER report = hexa run stdlib/rtsc/triangulate_decorr_run.hexa."
  before    = "composition proxies, full 42-set: effective_dim 1.51/4 · max|off-diag corr| 0.94 (A=mass·B=H-shape·C=H/former·D=McMillan-over-same-lambda all read the SAME 2-3 composition scalars)."
  after     = "decorrelated, superhydride family (real N(E_F)>=1.5, n=21): effective_dim 3.08/4 · max|off-diag corr| 0.529 · redundancy_warn=FALSE. full 42-set: 2.04/4 (the molecular/insulator tail PdH/H2O/B2H6 co-vanishes on B and C — REAL physics, not redundancy: no H-network => no H-DOS)."
  method    = "each proxy swapped for a real producer on a DIFFERENT info channel (d4 one-column swap, fusion+PCA core UNCHANGED): A=force-constant Debye omega (elastic/bonding, per-element H-X k table + reduced mass — NOT mean atomic mass); B=REAL N(E_F) literature/DFT anchor table (states/eV/cell, electronic channel — the decisive swap: CeH9/CeH10 4f-suppression gives LOW N(E_F) at HIGH h_frac, breaking the composition lock-step); C=REAL H-sublattice coordination from the known crystal structure (sodalite cage 4-6 vs molecular 1-2, crystal-chem channel); D=independent feature-basis Tc (EN-spread + VEC + radius-packing logistic — NOT McMillan over the lambda-proxy that made D~A)."
  matrix    = "AFTER family |corr|: A-B 0.43 · A-C -0.23 · A-D 0.53 · B-C 0.079 · B-D 0.089 · C-D -0.25. The proxy B-C=0.94 collapses to 0.079 within the family — the 0.80 on the full set is ENTIRELY the insulator tail."
  ranking   = "decorrelated consensus top: YH10·YH9·CaH10·ScH9·CaH6·LaH10·YH6·SrH10 — DFPT-confirmed anchors (CaH6·LaH10·YH9·Li2MgH16) stay top-10, molecular/control hydrides sink. Ranking integrity preserved."
  provenance = "hexa-lang stdlib/rtsc/triangulate_decorr.hexa (producers) + triangulate_decorr_run.hexa (BEFORE/AFTER report) + triangulate_test.hexa @ci_gate (extended). N(E_F)/coord anchors VERBATIM from hydride-SC literature (Wang PNAS 2012 · SciRep 2024 s41598-024-69190-0 · Liu/Errea LaH10 · Peng/Kong YH9 · Salke/Li CeH9 4f) + QFORGE dense-k CaH6 N(E_F)=13.09; NOT fitted/tuned."
  honest    = "d6: full-set effective_dim is 2.04 (not 3+), reported as-measured. 3.08 is the family value (the regime that matters for DFPT-target selection). residual B-C tail-correlation is real physics, NOT hidden. NO target number forced."
  remaining = "to push the FULL-set effective_dim up: replace the literature N(E_F)/coord ANCHOR TABLE with on-the-fly producers for the insulator tail too — a cheap 1-SCF qforge_dos_nef N(E_F) (the brick EXISTS, stdlib/qforge/dos_nef.hexa) + an ELF/graph H-coordination on a relaxed cell. That decorrelates the bottom of the set as well. DFPT confirmation of the top candidates stays a SEPARATE deferred QFORGE milestone (out of scope here)."

# ON-THE-FLY (table-free) producers — the full-set ceiling DECOMPOSED (artifact vs physics)
@F f5 := "Replacing the literature N(E_F)/coord ANCHOR TABLE with TABLE-FREE on-the-fly producers DECOMPOSES the 2.04 full-set ceiling: the 0.80 B-C correlation was ~ENTIRELY a proxy-table artifact (collapses to -0.19 when B,C are computed from independent raw channels), BUT the irreducible low-dimensionality is REAL and lives in a DIFFERENT pair — N(E_F) and the Tc-feature both read the valence-electron-count channel (B-D=0.79 in every variant, table or table-free). Full-set effective_dim 2.04 -> 2.50 (table-free, B,C decoupled) OR 1.95 (table-free + correct molecular-tail ranking) — the headline number depends on whether you DEMAND the cheap coordination producer rank molecular hydrides low, and that demand RE-COUPLES B,C through former-chemistry. Honest: the ceiling is PART artifact (the specific 0.80), PART genuine physics (the candidate space IS low-dimensional in an electron-count axis)." :: verified [active]
  grade     = "GREEN SUPPORTED-NUMERICAL — hexa run stdlib/rtsc/triangulate_test.hexa = 'triangulate_selftest PASS' (77/77 checks incl. the new on-the-fly gate); full decomposition report = hexa run stdlib/rtsc/triangulate_otf_run.hexa (CONFIG (1) anchor-table vs CONFIG (2) table-free, three regimes each)."
  producers = "B''=FREE-ELECTRON-GAS N(E_F): Sommerfeld g(E_F)=(3/2)N_val/E_F with E_F=3.80998·(3pi^2 n)^(2/3) eV, n=N_val/V_est, V_est=Wigner-Seitz sphere-sum/0.64 from element radii — a DERIVATION over the cell's OWN (N_val,V), times an H-1s metallization logistic in rho_H + an EN-gap insulator suppression. C''=GEOMETRIC H-H coordination: shell-volume × rho_H with an H-H bonding cutoff, times an H:former TOPOLOGY gate (NOT EN — keeps C orthogonal to B). BOTH table-free closed forms over all 42, NO per-formula constant. Cheap (ms), NOT a converged plane-wave SCF (d11: a genuine qforge_scf_pw DOS for 42 cells incl. molecular insulators is a multi-week campaign per the CaH6 anchor — out of scope for a cheap full-set screen; the free-electron DOS is the EXACT uniform-gas DOS + documented gates)."
  decomposition = "(a) PROXY-TABLE ARTIFACT (removed): B-C full-set corr 0.80 (table) -> -0.19 (table-free pure-geometric). The 0.80 was the two hand-tables co-varying, NOT physics — table-free, the free-electron N(E_F) and geometric coordination are ~uncorrelated. This LIFTS full-set effective_dim 2.04 -> 2.50. (b) GENUINE PHYSICS (irreducible): the dominant correlation in EVERY variant is B-D=0.79 (N(E_F) <-> feature-Tc) — both read the valence-electron-count / band-filling channel; this is real (DOS and Tc-propensity co-track band fill) and caps the table-free full set at ~2.5/4 even with B,C decoupled. (c) the molecular-tail co-vanishing IS real but NOT primarily a B-C effect: a pure number-density coordination MIS-ranks dense molecular hydrides (B2H6,SiH4) as HIGH-coordination (small est. cell -> high rho_H) — INVERTING the truth; correcting it needs an H:former topology gate, which re-couples B-C to 0.66 and pulls the full set to 1.95. So 'correct molecular ranking' and 'maximal B-C independence' TRADE OFF — the candidate space genuinely is low-dimensional in former-chemistry."
  matrix    = "table-free pure-geometric (v1) full |corr|: A-B 0.34 · A-C 0.18 · A-D 0.62 · B-C -0.19 · B-D 0.79 · C-D -0.07 ; effective_dim 2.50/4, redundancy_warn=FALSE. table-free topology-gated (v3) full |corr|: A-B 0.34 · A-C 0.48 · A-D 0.62 · B-C 0.66 · B-D 0.79 · C-D 0.54 ; effective_dim 1.95/4. anchor-table (baseline) full: B-C 0.80, effective_dim 2.04/4."
  three_regimes = "table-free (v1 pure-geometric): full 2.50 · full-minus-molecular-tail 2.46 · superhydride-family 2.19. anchor-table: full 2.04 · full-minus-tail 3.12 · family 3.08. NOTE the SIGN FLIP: the literature N(E_F) table is MORE independent WITHIN the family (it encodes real 4f-suppression physics a free-electron DOS cannot see -> high family effective_dim 3.08), while the table-free B'' is more independent on the FULL set (no table co-variation with C). Neither dominates everywhere — the table wins for family DFPT-target discrimination, the table-free wins for the artifact-free full-set measurement. Reported as-measured (d6)."
  ranking   = "ranking + anchor-top-10 integrity PRESERVED under the table-free B'',C'' (network hydrides high, molecular/insulator tail low after the topology gate; CaH6 C''=1.14 > B2H6 C''=0.51, B''(CaH6) > B''(B2H6) > B''(H2O) — asserted in the g5 gate)."
  provenance = "hexa-lang stdlib/rtsc/triangulate_otf.hexa (table-free producers) + triangulate_otf_run.hexa (CONFIG (1) vs (2) three-regime decomposition report) + triangulate_test.hexa @ci_gate gate-(7) extended to 77/77. d4 one-column swap (fusion+PCA core UNCHANGED). NO literature table read in B'',C'' (every value computed from parsed composition + periodic-table constants). NOT fitted to any Tc."
  honest    = "d6/d_paper_negative_ok: the FULL-set effective_dim does NOT cleanly exceed ~2.5 even table-free — and that is the FINDING, not a failure. The 0.80 B-C ceiling was mostly TABLE ARTIFACT (gone table-free), but the candidate space carries a GENUINE low intrinsic dimensionality: N(E_F) and Tc-propensity co-track band-filling (B-D=0.79), and correct molecular-tail discrimination forces a former-chemistry axis B,C share. The honest full-set number is 2.0-2.5/4 depending on the ranking constraint; fabricated nothing, forced no 3+."
  cheap_scf_note = "the literal qforge_dos_nef brick (stdlib/qforge/dos_nef.hexa) consumes band energies eps[] on an MP k-mesh from a CONVERGED multi-species qforge_scf_pw_h_multi_smeared SCF (pseudopotential staging + Ewald + smearing) — that is the CaH6-anchor-grade path (d11: multi-week for 42 cells, esp. molecular insulators). The free-electron Sommerfeld DOS is the cheap full-set complement: EXACT for the uniform gas, a sound metallic-DOS SCALE estimate, table-free per-formula. The genuine-SCF DOS stays the per-DFPT-target step (reserved, not full-set)."
