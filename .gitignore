**/state/markers/
state/mathvenv/
__pycache__/
.claude/*
!.claude/skills/
drafts/

# large data artifacts — kept on disk / summer originals, never in git (>100MB)
*_checkpoint.nc
*_stage.tgz
.harness/logs/
.harness/handoff/
