# hex-n6.demi — verb-cell manifest for the HEX-N6 (n=6 hexagonal lattice
# primitive · honeycomb arithmetic substrate) domain
# CLOAK meta-domain decomposition: 부품 3 of 3 (RTSC + SRR + HEX-N6 → CLOAK).
# SSOT scripts in ~/core/hexa-lang/stdlib/hex_n6/ (NOT YET WIRED — stub)
# Generic dispatcher: ~/core/hexa-lang/stdlib/cockpit/cellrun.hexa
# Demiurge witness: ActionDispatch → CellrunDispatch.run("hex-n6", verb)
#
# Format: cellrun.hexa Phase A dialect — [cell.<verb>] section headers,
# key=value lines, scope_caveats as multi-line [ "...", "..." ] array.
#
# Citations (anchored, not repeated per-cell — see domains/hex-n6.md):
#   - Hales, T. C. (2001) Discrete Comput. Geom. 25, 1 — honeycomb conjecture.
#   - atlas @P n6-{sigma,n,phi,j2,tau} (foundation atoms · embedded.gen.hexa).
#   - OEIS — A000203 (σ) · A000005 (τ) · A000010 (φ) · A001414 (sopfr).
#
# Domain caveat (applies to every cell):
# hex-n6 is a PRIMITIVE arithmetic substrate (not an engineering deliverable
# domain like CLOAK or SRR). Its absorbed criterion is satisfied by
# closed-form lattice identity verify (Phase A) — no wet-lab / no external
# measurement gate. cells below are STUB consumers for downstream domains
# that want to register lattice-anchored facts via cellrun.

# --- STUB: specify (n=6 lattice claim manifest) -----------------------------
[cell.specify]
substrate         = python3
python_candidates = python3.13, python3.12, python3
script            = stdlib/hex_n6/specify.py
record_kind       = hex_n6_specify_record
output_dir        = exports/hex-n6/specify
required_deps     = python3
gate_default      = OPEN
absorbed_default  = false
scope_caveats     = [
  "n=6 lattice claim manifest (which lattice identity is to be checked) — TEMPLATE.",
  "Phase A 🔵 anchors (sigma/tau/phi/sopfr/is_perfect/aliquot at n=6) already LANDED via hexa verify --expr.",
  "Real specify producer would enumerate ALL closed-form identities a consumer domain wants resolved.",
]

