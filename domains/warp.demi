[cell.specify]
substrate = python3
script = stdlib/warp/specify.py
record_kind = warp_specify_record
output_dir = exports/warp/specify
gate_default = OPEN
absorbed_default = false
scope_caveats = [
  "Warp drive target spec skeleton (payload · v_eff · exotic E_neg budget) — TEMPLATE.",
  "F-WARP-{1,2,3} falsifier preregister all OPEN; UNPROVEN at v1.0.0.",
  "measurement_gate = GATE_OPEN permanently — apparatus does not exist (g3).",
]

