# srr.demi — verb-cell manifest for the SRR (Split-Ring Resonator) domain
# CLOAK meta-domain decomposition: 부품 2 of 3 (RTSC + SRR + HEX-N6 → CLOAK).
# SSOT scripts in ~/core/hexa-lang/stdlib/srr/ (NOT YET WIRED — stub)
# Generic dispatcher: ~/core/hexa-lang/stdlib/cockpit/cellrun.hexa
# Demiurge witness: ActionDispatch → CellrunDispatch.run("srr", verb)
#
# Format: cellrun.hexa Phase A dialect — [cell.<verb>] section headers,
# key=value lines, scope_caveats as multi-line [ "...", "..." ] array.
#
# Citations (anchored, not repeated per-cell — see domains/srr.md):
#   - Pendry, J. B. (1999) IEEE TMTT 47, 2075 — original SRR Lorentz μ(ω).
#   - Smith et al. (2000) PRL 84, 4184 — first left-handed metamaterial.
#   - Schurig et al. (2006) Science 314, 977 — microwave carpet cloak SRR.
#   - UFO/CLOAK.md (in-tree, this repo) — H-CLK-1~12 lattice hypotheses.
#
# Domain caveat (applies to every cell):
# srr cells in this initial registration are STUB skeletons —
# stdlib/srr/<verb>.py producers DO NOT EXIST yet. cellrun
# dispatch will return rc=2 honest-skip until verb producers land.
# ALL cells stay GATE_OPEN / absorbed=false (g3 / d5).

# --- STUB: specify (SRR target-spec skeleton) -------------------------------
[cell.specify]
substrate         = python3
python_candidates = python3.13, python3.12, python3
script            = stdlib/srr/specify.py
record_kind       = srr_specify_record
output_dir        = exports/srr/specify
required_deps     = python3
gate_default      = OPEN
absorbed_default  = false
scope_caveats     = [
  "SRR target-spec skeleton (band / Q-factor target / loss budget / pitch) — TEMPLATE.",
  "Q=σ·τ=48 target inherits from n=6 lattice anchor (HEX-N6 sibling domain).",
  "measurement_gate = GATE_OPEN permanently — specify is illustrative, not an absorption claim (g3).",
]

