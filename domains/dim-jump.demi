# dim-jump.demi — verb-cell manifest for the DIM-JUMP (Kaluza-Klein
# dimensional-ladder propulsion) domain. UFO Stage-6 elevation.
# SSOT scripts in ~/core/hexa-lang/stdlib/dim_jump/ (NOT YET WIRED — stub)
#
# Citations: Kaluza-Klein dimensional reduction (standard text);
# UFO/dimjump/hexa-*.md — in-tree spec + F-DIM-{1,2,3} preregister.
#
# Domain caveat: All cells ⚪ SPECULATION-FENCED. Compactification radius
# < 1e-19 m per LHC bound; no detector for KK modes exists.

[cell.specify]
substrate = python3
script = stdlib/dim_jump/specify.py
record_kind = dim_jump_specify_record
output_dir = exports/dim-jump/specify
gate_default = OPEN
absorbed_default = false
scope_caveats = [
  "Dimensional-jump spec skeleton (target dimension · compactification scale) — TEMPLATE.",
  "F-DIM-{1,2,3} all OPEN; UNPROVEN at v1.0.0.",
]

