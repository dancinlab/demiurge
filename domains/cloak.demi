# cloak.demi — verb-cell manifest for the cloak (electromagnetic stealth /
# negative-index metamaterial / transformation-optics) domain
# SSOT scripts in ~/core/hexa-lang/stdlib/cloak/ (NOT YET WIRED — stub)
# Generic dispatcher: ~/core/hexa-lang/stdlib/cockpit/cellrun.hexa
# Demiurge witness: ActionDispatch → CellrunDispatch.run("cloak", verb)
#
# Format: cellrun.hexa Phase A dialect — [cell.<verb>] section headers,
# key=value lines, scope_caveats as multi-line [ "...", "..." ] array.
#
# Citations (anchored, not repeated per-cell — see domains/cloak.md):
#   - Veselago, V. G. (1968) Sov. Phys. Usp. 10, 509 — negative refraction.
#   - Pendry et al. (2006) Science 312, 1780 — transformation optics cloak.
#   - Smith et al. (2000) PRL 84, 4184 — split-ring metamaterial.
#   - Schurig et al. (2006) Science 314, 977 — microwave carpet cloak.
#   - UFO/CLOAK.md (in-tree, this repo) — Mk.I~V roadmap + 19-hypothesis ledger.
#
# Domain caveat (applies to every cell):
# cloak cells in this initial registration are STUB skeletons —
# stdlib/cloak/<verb>.py producers DO NOT EXIST yet. cellrun
# dispatch will return rc=2 honest-skip until verb producers land.
# ALL cells stay GATE_OPEN / absorbed=false (g3 / d5).

# --- STUB: specify (cloak target-spec skeleton) -----------------------------
[cell.specify]
substrate         = python3
python_candidates = python3.13, python3.12, python3
script            = stdlib/cloak/specify.py
record_kind       = cloak_specify_record
output_dir        = exports/cloak/specify
required_deps     = python3
gate_default      = OPEN
absorbed_default  = false
scope_caveats     = [
  "Cloak target-spec skeleton (RCS target / band / cell-pitch / cost) — TEMPLATE.",
  "F-22/B-2/F-35 reference RCS classes only — no engineering deliverable claim.",
  "measurement_gate = GATE_OPEN permanently — specify is illustrative, not an absorption claim (g3).",
]

