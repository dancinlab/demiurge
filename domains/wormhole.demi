# wormhole.demi — verb-cell manifest for the WORMHOLE (Morris-Thorne
# traversable space-hole propulsion) domain. UFO Stage-5 elevation.
# SSOT scripts in ~/core/hexa-lang/stdlib/wormhole/ (NOT YET WIRED — stub)
#
# Citations: Morris & Thorne (1988) Am. J. Phys. 56, 395 — original
# traversable wormhole; UFO/wormhole/hexa-*.md — in-tree spec + F-WORM-{1,2,3}.
#
# Domain caveat: All cells ⚪ SPECULATION-FENCED. Throat operates at
# Planck-scale (b₀ ~ ℓ_Pl · σ ≈ 1.94e-34 m); no apparatus exists.

[cell.specify]
substrate = python3
script = stdlib/wormhole/specify.py
record_kind = wormhole_specify_record
output_dir = exports/wormhole/specify
gate_default = OPEN
absorbed_default = false
scope_caveats = [
  "Traversable wormhole spec skeleton (throat b₀ · in/out region distance) — TEMPLATE.",
  "F-WORM-{1,2,3} all OPEN; UNPROVEN at v1.0.0.",
]

