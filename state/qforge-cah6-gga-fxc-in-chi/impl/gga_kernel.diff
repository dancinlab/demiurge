+// and ε⁻¹ APPLIED to the bare ∂V columns:  ∂V_scr(G) = Σ_{G'} ε⁻¹_{G,G'} ∂V_bare(G').
+//
+// d6 HONEST SCOPE: χ⁰ is summed over the conduction bands the caller supplies (the
+// front-end recovers nocc+ncond from Davidson). A truncated conduction set is a
+// LOWER bound on the local-field response — reported VERBATIM. Γ-only ⇒ q=0; the
+// G=0 row/col is the macroscopic head (kept finite by the Lindhard v_c floor).
+
+// witness: the full-ε path's condition diagnostics (last build).
+let mut PWFFT_EPS_N: int = 0          // matrix dimension (= npw)
+let mut PWFFT_EPS_NVC: int = 0        // #(occ→cond) transitions summed into χ⁰
+let mut PWFFT_EPS_MINDIAG: float = 0.0  // min |ε_{GG}| diagonal (singularity probe)
+let mut PWFFT_EPS_OFFFRAC: float = 0.0  // ‖offdiag(ε)‖/‖ε‖ — the local-field weight
+let mut PWFFT_EPS_PIVOT: float = 0.0    // min |pivot| during the LU solve (conditioning)
+// ε⁻¹ CACHE — ε(G,G') is direction-INDEPENDENT (built from the ground state only), so
+//   the LU-factored inverse is computed ONCE and reused across all 3 perturbation
+//   directions (a 3× walltime cut on the O(n³) solve). Reset by qpwfft_eps_reset.
+let mut PWFFT_EPSINV: [float] = []      // cached dense ε⁻¹ (n×n row-major)
+let mut PWFFT_EPSINV_N: int = 0
+pub fn qpwfft_eps_reset() { PWFFT_EPSINV = [] ; PWFFT_EPSINV_N = 0 ; PWFFT_EPS_NVC = 0
+                            PWFFT_FXC_CHI_FOLDS = 0 ; PWFFT_FXC_CHI_NORM = 0.0 }
+pub fn qpwfft_eps_n() -> int { return PWFFT_EPS_N }
+pub fn qpwfft_eps_nvc() -> int { return PWFFT_EPS_NVC }
+pub fn qpwfft_eps_mindiag() -> float { return PWFFT_EPS_MINDIAG }
+pub fn qpwfft_eps_offfrac() -> float { return PWFFT_EPS_OFFFRAC }
+pub fn qpwfft_eps_pivot() -> float { return PWFFT_EPS_PIVOT }
+
+// ── f_xc-IN-χ (TDDFT/ALDA Dyson kernel) — the BEYOND-RPA dielectric closure ─────
+//   RPA forms ε = δ − v_c·χ⁰ (Dyson kernel = bare Coulomb v_c ONLY). QE's DFPT
+//   computes the FULLY self-consistent KS response: δρ responds to δV_scf =
+//   δV_bare + (v_c + f_xc)·δρ — the xc kernel f_xc = δV_xc/δρ is INSIDE the loop.
+//   This toggle upgrades the dielectric to the TDDFT/ALDA form:
+//       ε_{G,G'} = δ − Σ_{G''} K_{G,G''}·χ⁰_{G'',G'},
+//       K_{G,G''} = v_c(G)·δ_{G,G''} + f_xc(G−G''),
+//   where f_xc(G−G') is the FFT of the real-space ALDA kernel f_xc[ρ(r)] =
+//   f_x[ρ(r)] + f_c[ρ(r)] (LDA-x + PW92-c, the SAME kernels the diagonal local-field
+//   fold uses). The off-diagonal f_xc(G−G') is the local-field-resolved xc the RPA
+//   Dyson kernel (v_c only) drops — the irreducible residual the Sternheimer-χ⁰
+//   round named VERBATIM. d4 GENERIC — a single toggle; the kernel is DATA. d6.
+let mut PWFFT_FXC_IN_CHI: bool = false  // when true ε uses the (v_c+f_xc) Dyson kernel
+let mut PWFFT_FXC_CHI_FOLDS: int = 0    // #f_xc(G−G') matrix entries folded (witness)
+let mut PWFFT_FXC_CHI_NORM: float = 0.0 // ‖f_xc-kernel‖/‖v_c-kernel‖ on the diag (witness)
+pub fn qpwfft_set_fxc_in_chi(on: bool) { PWFFT_FXC_IN_CHI = on }
+pub fn qpwfft_fxc_in_chi_on() -> bool { return PWFFT_FXC_IN_CHI }
+pub fn qpwfft_fxc_chi_folds() -> int { return PWFFT_FXC_CHI_FOLDS }
+pub fn qpwfft_fxc_chi_norm() -> float { return PWFFT_FXC_CHI_NORM }
+
+// ── f_xc-in-χ KERNEL FLAVOR (d4 toggle: ALDA | GGA) — A2 round ────────────────────
+//   false = ALDA  : f_xc[ρ(r)] = f_x^LDA(ρ) + f_c^PW92(ρ)   (local 2nd-deriv of LDA xc).
+//   true  = GGA   : f_xc^GGA[ρ,∇ρ] = ∂²e_xc^PBE/∂ρ²|_{∇ρ}  (PBE xc, gradient-carrying).
+//   The GGA branch builds |∇ρ|(r) by spectral differentiation (FFT·iG·IFFT) of ρ(r),
+//   so the kernel carries the H-cage high-gradient sign/magnitude the ALDA local-x drops.
+//   The ALDA round was over-screening (f_x^LDA<0 → λ pushed BELOW QE); GGA is the next
+//   named lever (its sign is NOT predicted by ALDA). default false = ALDA (no regression).
+let mut PWFFT_FXC_GGA: bool = false      // f_xc-in-χ kernel = GGA(PBE) when true, else ALDA
+let mut PWFFT_FXC_GGA_GRADMEAN: float = 0.0 // witness: mean |∇ρ|/ρ over the cage (GGA-engaged)
+pub fn qpwfft_set_fxc_gga(on: bool) { PWFFT_FXC_GGA = on }
+pub fn qpwfft_fxc_gga_on() -> bool { return PWFFT_FXC_GGA }
+pub fn qpwfft_fxc_gga_gradmean() -> float { return PWFFT_FXC_GGA_GRADMEAN }
+
+// ── PBE GGA xc kernel pieces (private — SSOT pub fns live in correlation.hexa; these
+//    are the f_xc-in-χ-local helpers so the install tree stays self-contained, advisory).
+//    ε_x^PBE = ε_x^LDA·F_x(s), F_x(s)=1+κ−κ/(1+μs²/κ), κ=0.804, μ=0.21951,
+//    s=|∇ρ|/(2k_F ρ), k_F=(3π²ρ)^{1/3}.  s→0 ⇒ F_x→1 ⇒ Slater (ALDA-continuous). ──────
+let _QP_PBE_KAPPA = 0.8040
+let _QP_PBE_MU = 0.2195149727645171
+let _QP_PI = 3.14159265358979323846
+fn _qpwfft_fx_enh_pbe(s: float) -> float {
+    let k = _QP_PBE_KAPPA
+    let s2 = s * s
+    return 1.0 + k - k / (1.0 + _QP_PBE_MU * s2 / k)
+}
+fn _qpwfft_ex_pbe(rho: float, grad_rho: float) -> float {
+    if rho <= 0.0 { return 0.0 }
+    let third = 1.0 / 3.0
+    let ex_lda = -0.75 * pow(3.0 / _QP_PI, third) * pow(rho, third)
+    let kf = pow(3.0 * _QP_PI * _QP_PI * rho, third)
+    let s = grad_rho / (2.0 * kf * rho)
+    return ex_lda * _qpwfft_fx_enh_pbe(s)
+}
+// e_xc^PBE(ρ,|∇ρ|) = ρ·(ε_x^PBE + ε_c^PBE)  (|∇ρ| held FIXED — local GGA-kernel approx).
+fn _qpwfft_exc_pbe_dens(rho: float, grad_rho: float) -> float {
+    if rho <= 0.0 { return 0.0 }
+    return rho * (_qpwfft_ex_pbe(rho, grad_rho) + qforge_ec_pbe_from_rho(rho, grad_rho))
+}
+// f_xc^GGA = ∂²e_xc^PBE/∂ρ²|_{∇ρ}  (PARALLEL to ALDA's d²e_xc^LDA/dρ²; central 2nd-diff).
+fn _qpwfft_fxc_gga(rho: float, grad_rho: float) -> float {
+    if rho <= 0.0 { return 0.0 }
+    let mut h = rho * 1.0e-4
+    if h < 1.0e-10 { h = 1.0e-10 }
+    let e_p = _qpwfft_exc_pbe_dens(rho + h, grad_rho)
+    let e_0 = _qpwfft_exc_pbe_dens(rho, grad_rho)
+    let e_m = _qpwfft_exc_pbe_dens(rho - h, grad_rho)
+    return (e_p - 2.0 * e_0 + e_m) / (h * h)
+}
+// |∇ρ|(r) by spectral differentiation: ∂_α ρ = IFFT[ i G_α ρ̂(G) ], |∇ρ|=√(Σ_α (∂_α ρ)²).
+//   rho_r = physical ρ(r) grid (length ntot). Returns |∇ρ|(r) (length ntot); [] on fail.
+fn _qpwfft_grad_rho(rho_r: [float]) -> [float] {
+    let ntot = PWFFT_NX * PWFFT_NY * PWFFT_NZ
+    if len(rho_r) != ntot { return [] }
+    if len(PWFFT_B1) != 3 || len(PWFFT_B2) != 3 || len(PWFFT_B3) != 3 { return [] }
+    // forward FFT ρ(r)→ρ̂(G)  (interleaved [re,im,…]).
+    let mut rcp: [float] = []
+    let mut p0 = 0
+    while p0 < ntot { rcp.push(rho_r[p0]) ; p0 = p0 + 1 }
+    let rhat = fft3(rcp, _qpwfft_zim(), PWFFT_NX, PWFFT_NY, PWFFT_NZ)
+    if len(rhat) != 2 * ntot { return [] }
+    // per axis α: build (i G_α ρ̂)(G) then IFFT → ∂_α ρ(r); accumulate squares.
+    let mut gsq: [float] = []
+    let mut z = 0
+    while z < ntot { gsq.push(0.0) ; z = z + 1 }
+    let mut axis = 0
+    while axis < 3 {
+        let mut der_re: [float] = []
+        let mut der_im: [float] = []
+        let mut ix = 0
+        while ix < PWFFT_NX {
+            let mut iy = 0
+            while iy < PWFFT_NY {
+                let mut iz = 0
+                while iz < PWFFT_NZ {
+                    let h = _qpwfft_freq(ix, PWFFT_NX)
+                    let k = _qpwfft_freq(iy, PWFFT_NY)
+                    let l = _qpwfft_freq(iz, PWFFT_NZ)
+                    let ga = if axis == 0 {
+                        to_float(h) * PWFFT_B1[0] + to_float(k) * PWFFT_B2[0] + to_float(l) * PWFFT_B3[0]
+                    } else if axis == 1 {
+                        to_float(h) * PWFFT_B1[1] + to_float(k) * PWFFT_B2[1] + to_float(l) * PWFFT_B3[1]
+                    } else {
+                        to_float(h) * PWFFT_B1[2] + to_float(k) * PWFFT_B2[2] + to_float(l) * PWFFT_B3[2]
+                    }
+                    let lin = (ix * PWFFT_NY + iy) * PWFFT_NZ + iz
+                    // i·G_α·(re+i·im) = (−G_α·im) + i·(G_α·re).
+                    der_re.push(-ga * rhat[lin * 2 + 1])
+                    der_im.push(ga * rhat[lin * 2])
+                    iz = iz + 1
+                }
+                iy = iy + 1
+            }
+            ix = ix + 1
+        }
+        let dr = ifft3(der_re, der_im, PWFFT_NX, PWFFT_NY, PWFFT_NZ)
+        if len(dr) != 2 * ntot { return [] }
+        let mut q = 0
+        while q < ntot { let v = dr[q * 2] ; gsq[q] = gsq[q] + v * v ; q = q + 1 }
+        axis = axis + 1
+    }
+    let mut grad: [float] = []
+    let mut q2 = 0
+    while q2 < ntot { grad.push(sqrt(gsq[q2])) ; q2 = q2 + 1 }
+    return grad
+}
+
+// ── cross-density ρ_{vc}(G_i) = FFT[ ψ_v(r) ψ_c(r) ] gathered at the PW G-vectors.
+//   psi_v_r, psi_c_r : the two states' real-space grids (length ntot, from _to_real).
+//   Returns the length-n coefficient vector (real part — Γ-real ψ). The ÷Ntot at the
+//   gather matches the scatter→ifft→·→fft round-trip the diagonal kernel uses, so
+//   ρ_{vc}(G) lands at the same coefficient amplitude convention as c_v(G).
+fn _qpwfft_cross_density(psi_v_r: [float], psi_c_r: [float]) -> [float] {
+    let ntot = PWFFT_NX * PWFFT_NY * PWFFT_NZ
+    // ψ_v(r)·ψ_c(r) on the real-space cube (REAL0 holds v, REAL1 holds c — distinct).
+    PWFFT_DRHO = _qpwfft_grid_zeroed(PWFFT_DRHO, ntot)
+    let prod = PWFFT_DRHO
+    // FFT-norm: each ψ_r carries ÷Ntot (ifft3 convention); the physical product is
+    // ψ_v(r)ψ_c(r) with ψ=Σ_G c e^{iGr} (no 1/Ntot), so restore ×Ntot² (same DERIVED
+    // factor the density-response kernel uses at line ~444).
+    let nt2 = to_float(ntot) * to_float(ntot)
+    let mut r = 0
+    while r < ntot { prod[r] = psi_v_r[r] * psi_c_r[r] * nt2 ; r = r + 1 }
+    let spec = fft3(prod, _qpwfft_zim(), PWFFT_NX, PWFFT_NY, PWFFT_NZ)
+    if len(spec) != 2 * ntot { return [] }
+    let inv_ntot = 1.0 / to_float(ntot)
+    let mut out: [float] = []
+    let mut i = 0
+    while i < PWFFT_N { out.push(spec[PWFFT_LIN[i] * 2] * inv_ntot) ; i = i + 1 }
+    return out
+}
+
+// ── |q+G_i|² (Γ ⇒ q=0) from the staged Miller indices + reciprocal basis ────────
+fn _qpwfft_g2_of(i: int) -> float {
+    let gx = to_float(PWFFT_HH[i]) * PWFFT_B1[0] + to_float(PWFFT_KK[i]) * PWFFT_B2[0]
+           + to_float(PWFFT_LL[i]) * PWFFT_B3[0]
+    let gy = to_float(PWFFT_HH[i]) * PWFFT_B1[1] + to_float(PWFFT_KK[i]) * PWFFT_B2[1]
+           + to_float(PWFFT_LL[i]) * PWFFT_B3[1]
+    let gz = to_float(PWFFT_HH[i]) * PWFFT_B1[2] + to_float(PWFFT_KK[i]) * PWFFT_B2[2]
+           + to_float(PWFFT_LL[i]) * PWFFT_B3[2]
+    return gx * gx + gy * gy + gz * gz
+}
+
+// ── dense real linear solve A·X = B (Gaussian elimination, partial pivoting).
+//   A : n×n row-major (length n²) — OVERWRITTEN. B : n×m row-major (length n·m) —
+//   OVERWRITTEN with the solution X. Returns the min |pivot| seen (conditioning
+//   witness; ≈0 ⇒ near-singular). d19 — self-contained (no linalg dep that lacks a
+//   dense solve); the matrix is npw≤~700 → O(n³) tractable on CPU (d11).
+fn _qpwfft_lin_solve(A: [float], B: [float], n: int, m: int) -> float {
+    let mut minpiv = 1.0e300
+    let mut col = 0
+    while col < n {
+        // partial pivot: largest |A[row][col]| over row≥col.
+        let mut piv = col
+        let mut best = A[col * n + col]
+        if best < 0.0 { best = -best }
+        let mut rr = col + 1
+        while rr < n {
+            let mut v = A[rr * n + col]
+            if v < 0.0 { v = -v }
+            if v > best { best = v ; piv = rr }
+            rr = rr + 1
+        }
+        if best < minpiv { minpiv = best }
+        if piv != col {
+            let mut cc = 0
+            while cc < n {
+                let t = A[col * n + cc] ; A[col * n + cc] = A[piv * n + cc] ; A[piv * n + cc] = t
+                cc = cc + 1
+            }
+            let mut cm = 0
+            while cm < m {
+                let t = B[col * m + cm] ; B[col * m + cm] = B[piv * m + cm] ; B[piv * m + cm] = t
+                cm = cm + 1
+            }
+        }
+        let d = A[col * n + col]
+        if d > -1.0e-300 && d < 1.0e-300 { return 0.0 }   // singular
+        // eliminate below.
+        let mut row = col + 1
+        while row < n {
+            let f = A[row * n + col] / d
+            if f != 0.0 {
+                let mut cc = col
+                while cc < n { A[row * n + cc] = A[row * n + cc] - f * A[col * n + cc] ; cc = cc + 1 }
+                let mut cm = 0
+                while cm < m { B[row * m + cm] = B[row * m + cm] - f * B[col * m + cm] ; cm = cm + 1 }
+            }
+            row = row + 1
+        }
+        col = col + 1
+    }
+    // back-substitution per RHS column.
+    let mut cm = 0
+    while cm < m {
+        let mut row = n - 1
+        while row >= 0 {
+            let mut s = B[row * m + cm]
+            let mut cc = row + 1
+            while cc < n { s = s - A[row * n + cc] * B[cc * m + cm] ; cc = cc + 1 }
+            B[row * m + cm] = s / A[row * n + row]
+            row = row - 1
+        }
+        cm = cm + 1
+    }
+    return minpiv
+}
+
+// ── _qpwfft_build_fxc_gfield — the ALDA xc-kernel field f_xc(G) for the f_xc-in-χ
+//    Dyson closure. From the occupied real-space states ψ_v(r) (already FFT'd by the
+//    eps builder), reconstruct ρ(r)=Σ_v 2·ψ_v(r)²·(Ntot²/Ω) (the SAME physical-density
+//    normalization the diagonal local-ALDA fold uses, lane-3 verified), evaluate the
+//    ALDA kernel f_xc[ρ(r)] = f_x[ρ] (LDA-x) + f_c[ρ] (PW92-c), FFT it, and return the
+//    UNNORMALIZED grid spectrum [re,im,…] (length 2·ntot). The convolution-theorem
+//    normalization (÷Ntot) is applied at the GATHER in the ε build, matching the
+//    diagonal fold's ΔV_xc(G)=Σ_{G'} f_xc(G−G')Δρ(G') convention exactly. d6.
+fn _qpwfft_build_fxc_gfield(occ_rs: [[float]], omega: float) -> [float] {
+    let ntot = PWFFT_NX * PWFFT_NY * PWFFT_NZ
+    let nocc = len(occ_rs)
+    if nocc < 1 || omega <= 0.0 { return [] }
+    // ρ(r) = Σ_v 2·ψ_v(r)²  (grid-weight convention from _to_real's ÷Ntot ifft3).
+    let dens_scale = to_float(ntot) * to_float(ntot) / omega   // → physical ρ(r) (bohr⁻³)
+    // build the physical ρ(r) grid first (needed for the GGA |∇ρ| spectral derivative).
+    let mut rho_grid: [float] = []
+    let mut rr = 0
+    while rr < ntot {
+        let mut w = 0.0
+        let mut v = 0
+        while v < nocc { let psv = occ_rs[v][rr] ; w = w + 2.0 * psv * psv ; v = v + 1 }
+        rho_grid.push(w * dens_scale)
+        rr = rr + 1
+    }
+    // GGA: precompute |∇ρ|(r) once (spectral FFT·iG·IFFT) + a gradient witness. ──────────
+    let mut grad_grid: [float] = []
+    if PWFFT_FXC_GGA {
+        grad_grid = _qpwfft_grad_rho(rho_grid)
+        if len(grad_grid) == ntot {
+            let mut gsum = 0.0 ; let mut gcnt = 0
+            let mut gg = 0
+            while gg < ntot {
+                if rho_grid[gg] > 1.0e-8 { gsum = gsum + grad_grid[gg] / rho_grid[gg] ; gcnt = gcnt + 1 }
+                gg = gg + 1
+            }
+            PWFFT_FXC_GGA_GRADMEAN = if gcnt > 0 { gsum / to_float(gcnt) } else { 0.0 }
+        }
+    }
+    let gga_live = PWFFT_FXC_GGA && len(grad_grid) == ntot
+    let mut fxc_r: [float] = []
+    let mut r = 0
+    while r < ntot {
+        let rho_phys = rho_grid[r]
+        let mut fxc = 0.0
+        if rho_phys > 0.0 {
+            if gga_live {
+                // GGA(PBE) f_xc^GGA[ρ,∇ρ] = ∂²e_xc^PBE/∂ρ² — gradient-carrying kernel.
+                fxc = _qpwfft_fxc_gga(rho_phys, grad_grid[r])
+            } else {
+                if PWFFT_XCMODE >= 1 { fxc = fxc + qforge_fx_lda(rho_phys) }   // ALDA LDA exchange
+                if PWFFT_XCMODE >= 2 { fxc = fxc + qforge_fc_pw92(rho_phys) }  // ALDA PW92 correlation
+            }
+        }
+        fxc_r.push(fxc)
+        r = r + 1
+    }
+    let spec = fft3(fxc_r, _qpwfft_zim(), PWFFT_NX, PWFFT_NY, PWFFT_NZ)
+    if len(spec) != 2 * ntot { return [] }
+    return spec
+}
+
+// ── _qpwfft_fxc_g — f_xc(G_i − G_j) coefficient from the precomputed grid spectrum.
+//    Miller(G_i−G_j) wrapped to the FFT grid; ÷Ntot restores the convolution-theorem
+//    coefficient amplitude (matches v_c(G_i) / ρ_vc(G) ÷Ntot convention). Returns the
+//    REAL part (Γ-real ground state ⇒ f_xc[ρ(r)] real ⇒ f_xc(−G)=f_xc(G)* real-sym).
+fn _qpwfft_fxc_g(spec: [float], gi: int, gj: int, inv_ntot: float) -> float {
+    let dh = PWFFT_HH[gi] - PWFFT_HH[gj]
+    let dk = PWFFT_KK[gi] - PWFFT_KK[gj]
+    let dl = PWFFT_LL[gi] - PWFFT_LL[gj]
+    let ix = _qpwfft_wrap(dh, PWFFT_NX)
+    let iy = _qpwfft_wrap(dk, PWFFT_NY)
+    let iz = _qpwfft_wrap(dl, PWFFT_NZ)
+    let lin = (ix * PWFFT_NY + iy) * PWFFT_NZ + iz
+    return spec[lin * 2] * inv_ntot
+}
+
+// ── qpwfft_eps_matrix_screen — BUILD ε_{G,G'}(q=0), INVERT, APPLY ε⁻¹ to the bare
+//    ∂V columns. THE full local-field matrix-Dyson replacement for the diagonal head.
+//   occ_r   : nocc occupied ψ_v PW-coefficient columns (each length n).
+//   cond_r  : ncond conduction ψ_c PW-coefficient columns (each length n).
+//   eps_occ : nocc occupied eigenvalues ε_v (Ha).
+//   eps_cond: ncond conduction eigenvalues ε_c (Ha).
+//   bare_cols: nb bare ∂V|ψ⟩ columns (each length n) to screen.
+//   omega   : cell volume Ω (bohr³) — the χ⁰ normalization (2/Ω) prefactor.
+//   Returns the nb ε⁻¹-screened columns (each length n); [] on malformed / grid off.
+//   The Coulomb v_c(G) uses _qpwfft_vhartree_factor (Lindhard-regularized when on) —
+//   IDENTICAL to the diagonal path, so the ONLY change vs prior rounds is the full
+//   off-diagonal ε(G,G') matrix inversion. d6 — witnesses recorded for the verdict.
+pub fn qpwfft_eps_matrix_screen(occ_r: [[float]], cond_r: [[float]],
+                                eps_occ: [float], eps_cond: [float],
+                                bare_cols: [[float]], omega: float) -> [[float]] {
+    if !PWFFT_ON { return [] }
+    let n = PWFFT_N
+    let nocc = len(occ_r)
+    let ncond = len(cond_r)
+    let nb = len(bare_cols)
+    if nocc < 1 || ncond < 1 || nb < 1 || omega <= 0.0 { return [] }
+    if len(eps_occ) != nocc || len(eps_cond) != ncond { return [] }
+    let ntot = PWFFT_NX * PWFFT_NY * PWFFT_NZ
+
+    // ── FAST PATH: ε⁻¹ already built (a prior direction this run) — just apply it.
+    //    ε(G,G') is direction-independent (ground-state-only), so reuse the cached
+    //    inverse: ∂V_scr(G)=Σ_G' ε⁻¹_{G,G'} ∂V_bare(G') (a matvec per column). ───────
+    if PWFFT_EPSINV_N == n && len(PWFFT_EPSINV) == n * n {
+        return _qpwfft_apply_epsinv(bare_cols, n, nb)
+    }
+
+    // ── pre-transform every state to real space ψ(r) (one ifft3 each — reused over
+    //    all (v,c) pairs; ncond+nocc transforms total, not nocc·ncond). ────────────
+    let mut occ_rs: [[float]] = []
+    let mut vb = 0
+    while vb < nocc {
+        if len(occ_r[vb]) != n { return [] }
+        let pr = _qpwfft_to_real(_qpwfft_scatter(occ_r[vb]), 0)
+        if len(pr) != ntot { return [] }
+        // COPY out of the shared slot (the next _to_real overwrites REAL0).
+        let mut cp: [float] = []
+        let mut q = 0
+        while q < ntot { cp.push(pr[q]) ; q = q + 1 }
+        occ_rs.push(cp)
+        vb = vb + 1
+    }
+    let mut cond_rs: [[float]] = []
+    let mut cb = 0
+    while cb < ncond {
+        if len(cond_r[cb]) != n { return [] }
+        let pr = _qpwfft_to_real(_qpwfft_scatter(cond_r[cb]), 0)
+        if len(pr) != ntot { return [] }
+        let mut cp: [float] = []
+        let mut q = 0
+        while q < ntot { cp.push(pr[q]) ; q = q + 1 }
+        cond_rs.push(cp)
+        cb = cb + 1
+    }
+
+    // ── build χ⁰_{G,G'} = (4/Ω) Σ_{v,c} ρ_{vc}(G) ρ_{vc}(G') / (ε_v − ε_c) ────────
+    //   spin-degenerate factor 2 × static-limit resonant+antiresonant factor 2 = 4.
+    //   (ε_v − ε_c) < 0 ⇒ χ⁰ negative-definite (correct sign for a polarizable medium).
+    let mut chi0: [float] = []
+    let mut z0 = 0
+    while z0 < n * n { chi0.push(0.0) ; z0 = z0 + 1 }
+    let pref = 4.0 / omega
+    let mut vv = 0
+    while vv < nocc {
+        let mut cc2 = 0
+        while cc2 < ncond {
+            let de = eps_occ[vv] - eps_cond[cc2]
+            if de < -1.0e-10 {                       // genuine occ→empty gap
+                // ρ_{vc}(G) = FFT[ ψ_v(r) ψ_c(r) ]  (length n).
+                let rho_vc = _qpwfft_cross_density(occ_rs[vv], cond_rs[cc2])
+                if len(rho_vc) == n {
+                    let w = pref / de                // < 0
+                    // χ⁰ += w · ρ(G) ρ(G')  (outer product accumulate, symmetric).
+                    let mut gi = 0
+                    while gi < n {
+                        let wr = w * rho_vc[gi]
+                        if wr != 0.0 {
+                            let base = gi * n
+                            let mut gj = 0
+                            while gj < n { chi0[base + gj] = chi0[base + gj] + wr * rho_vc[gj] ; gj = gj + 1 }
+                        }
+                        gi = gi + 1
+                    }
+                    PWFFT_EPS_NVC = PWFFT_EPS_NVC + 1
+                }
+            }
+            cc2 = cc2 + 1
+        }
+        vv = vv + 1
+    }
+
+    // ── DYSON KERNEL K = v_c + (f_xc-in-χ ⇒ + f_xc) ────────────────────────────────
+    //   RPA:        ε_{G,G'} = δ − v_c(G)·χ⁰_{G,G'}                   (kernel = v_c only)
+    //   f_xc-in-χ:  ε_{i,j}  = δ − v_c(i)·χ⁰_{i,j} − Σ_k f_xc(i−k)·χ⁰_{k,j}
+    //               (TDDFT/ALDA — the FULLY self-consistent KS response QE's DFPT carries:
+    //                δρ ← δV_scf = δV_bare + (v_c+f_xc)·δρ, f_xc INSIDE the Dyson loop).
+    //   v_c(G_i) per row; G=0 → 0 (neutral-cell gauge). f_xc(i−k) is the ALDA xc-kernel
+    //   field FFT'd to G-space (built ONCE below; the local-field-resolved xc the RPA
+    //   Dyson kernel drops — the Sternheimer-round-named irreducible residual). d2/d6.
+    let mut vcoul: [float] = []
+    let mut gi2 = 0
+    while gi2 < n { vcoul.push(_qpwfft_vhartree_factor(_qpwfft_g2_of(gi2))) ; gi2 = gi2 + 1 }
+    // build the ALDA f_xc(G) grid spectrum once (real-space f_xc[ρ(r)] → FFT) if engaged.
+    let mut fxc_spec: [float] = []
+    let inv_ntot = 1.0 / to_float(ntot)
+    if PWFFT_FXC_IN_CHI {
+        fxc_spec = _qpwfft_build_fxc_gfield(occ_rs, omega)
+        if len(fxc_spec) == 2 * ntot {
+            // witness: ‖f_xc(G=0)‖ vs a representative ‖v_c‖ (the kernel-weight ratio).
+            let fxc0 = fxc_spec[0] * inv_ntot
+            let af = if fxc0 < 0.0 { -fxc0 } else { fxc0 }
+            let mut vmax = 0.0 ; let mut vi = 0
+            while vi < n { let av = if vcoul[vi] < 0.0 { -vcoul[vi] } else { vcoul[vi] }
+                           if av > vmax { vmax = av } ; vi = vi + 1 }
+            PWFFT_FXC_CHI_NORM = if vmax > 0.0 { af / vmax } else { 0.0 }
+        } else { fxc_spec = [] }                          // build failed → RPA fallback
+    }
+    let fxc_live = PWFFT_FXC_IN_CHI && len(fxc_spec) == 2 * ntot
+    let mut eps: [float] = []
+    let mut z1 = 0
+    while z1 < n * n { eps.push(0.0) ; z1 = z1 + 1 }
+    let mut off_ss = 0.0 ; let mut tot_ss = 0.0 ; let mut mindiag = 1.0e300
+    let mut gr = 0
+    while gr < n {
+        let vcg = vcoul[gr]
+        let base = gr * n
+        // f_xc-in-χ: precompute the F-row F_{gr,k}=f_xc(G_gr−G_k) ONCE per row (avoids the
+        //   n× redundant gather inside the gc loop), then the term is −Σ_k F_row[k]·χ⁰_{k,j}.
+        let mut frow: [float] = []
+        if fxc_live {
+            let mut kk2 = 0
+            while kk2 < n { frow.push(_qpwfft_fxc_g(fxc_spec, gr, kk2, inv_ntot)) ; kk2 = kk2 + 1 }
+        }
+        let mut gc = 0
+        while gc < n {
+            // RPA term: −v_c(G_i)·χ⁰_{i,j}.
+            let mut e = -vcg * chi0[base + gc]
+            // f_xc-in-χ term: −Σ_k f_xc(G_i−G_k)·χ⁰_{k,j} (TDDFT/ALDA Dyson kernel).
+            if fxc_live {
+                let mut acc = 0.0
+                let mut kk3 = 0
+                while kk3 < n {
+                    let fik = frow[kk3]
+                    if fik != 0.0 { acc = acc + fik * chi0[kk3 * n + gc] }
+                    kk3 = kk3 + 1
+                }
+                e = e - acc
+                PWFFT_FXC_CHI_FOLDS = PWFFT_FXC_CHI_FOLDS + 1
+            }
+            if gr == gc { e = e + 1.0 }
+            eps[base + gc] = e
+            let ea = if e < 0.0 { -e } else { e }
+            tot_ss = tot_ss + e * e
+            if gr != gc { off_ss = off_ss + e * e }
+            if gr == gc && ea < mindiag { mindiag = ea }
+            gc = gc + 1
+        }
+        gr = gr + 1
+    }
+    PWFFT_EPS_N = n
+    PWFFT_EPS_MINDIAG = mindiag
+    PWFFT_EPS_OFFFRAC = if tot_ss > 0.0 { sqrt(off_ss / tot_ss) } else { 0.0 }
+
+    // ── INVERT ONCE: solve ε·X = I → X = ε⁻¹ (n×n), CACHE it (direction-independent). ─
+    //    B starts as the identity; after _qpwfft_lin_solve, B holds ε⁻¹ (row-major).
+    let mut B: [float] = []
+    let mut z2 = 0
+    while z2 < n * n { B.push(0.0) ; z2 = z2 + 1 }
+    let mut di = 0
+    while di < n { B[di * n + di] = 1.0 ; di = di + 1 }
+    let piv = _qpwfft_lin_solve(eps, B, n, n)
+    PWFFT_EPS_PIVOT = piv
+    if piv <= 0.0 { return [] }                          // singular ε — honest fail
+    PWFFT_EPSINV = B ; PWFFT_EPSINV_N = n                 // cache ε⁻¹ for the next dir
+    // ── APPLY ε⁻¹ to the bare columns: ∂V_scr(G)=Σ_G' ε⁻¹_{G,G'} ∂V_bare(G'). ───────
+    return _qpwfft_apply_epsinv(bare_cols, n, nb)
+}
+
+// ── apply the cached dense ε⁻¹ (n×n row-major) to nb bare ∂V columns (matvec each).
+//    ∂V_scr_k(G) = Σ_{G'} ε⁻¹_{G,G'} ∂V_bare_k(G').  Returns nb screened columns.
+fn _qpwfft_apply_epsinv(bare_cols: [[float]], n: int, nb: int) -> [[float]] {
+    let mut cols: [[float]] = []
+    let mut k = 0
+    while k < nb {
+        if len(bare_cols[k]) != n { return [] }
+        let bk = bare_cols[k]
+        let mut col: [float] = []
+        let mut gr = 0
+        while gr < n {
+            let base = gr * n
+            let mut s = 0.0
+            let mut gc = 0
+            while gc < n { s = s + PWFFT_EPSINV[base + gc] * bk[gc] ; gc = gc + 1 }
+            col.push(s)
+            gr = gr + 1
+        }
+        cols.push(col)
+        k = k + 1
+    }
+    return cols
+}
