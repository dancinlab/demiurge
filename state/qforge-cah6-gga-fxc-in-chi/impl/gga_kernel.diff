+// ── _qpwfft_lindhard_F — the static 3D Lindhard function F_L(x), x=q/2k_F ─────────
+//   F_L(x) = ½ + (1−x²)/(4x)·ln|(1+x)/(1−x)|.  F_L(0)=1 (TF limit), F_L→0 as x→∞.
+//   x→1 is the 2k_F Kohn point (the (1−x²) prefactor →0 kills the log there).
+fn _qpwfft_lindhard_F(x: float) -> float {
+    if x < 1.0e-8 { return 1.0 }
+    let xa = if x < 0.0 { -x } else { x }
+    let d = 1.0 - xa
+    let da = if d < 0.0 { -d } else { d }
+    if da < 1.0e-8 { return 0.5 }                                // F_L(1) = ½
+    let lg = log((1.0 + xa) / da)
+    return 0.5 + (1.0 - xa * xa) / (4.0 * xa) * lg
