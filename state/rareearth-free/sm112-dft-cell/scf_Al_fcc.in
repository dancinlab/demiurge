&CONTROL
  calculation='scf'  prefix='Al'  outdir='./out/'  pseudo_dir='./pseudo/'  verbosity='high'
/
&SYSTEM
  ibrav=2  celldm(1)=7.65  nat=1  ntyp=1     ! fcc Al a=4.05 Ang in bohr
  ecutwfc=80.0  ecutrho=320.0
  occupations='smearing' smearing='mv' degauss=0.02
/
&ELECTRONS
  electron_maxstep=400  mixing_beta=0.4  conv_thr=1.0d-8
/
ATOMIC_SPECIES
  Al 26.98 Al_ONCV_PBE_sr.upf
ATOMIC_POSITIONS (crystal)
Al 0.0 0.0 0.0
K_POINTS (automatic)
  16 16 16 0 0 0
