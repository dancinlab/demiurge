&CONTROL
  calculation='scf'  prefix='Cu'  outdir='./out/'  pseudo_dir='./pseudo/'  verbosity='high'
/
&SYSTEM
  ibrav=2  celldm(1)=6.83  nat=1  ntyp=1
  ecutwfc=80.0  ecutrho=320.0
  occupations='smearing' smearing='mv' degauss=0.02
/
&ELECTRONS
  electron_maxstep=400  mixing_beta=0.4  conv_thr=1.0d-8
/
ATOMIC_SPECIES
  Cu 63.55 Cu_ONCV_PBE_sr.upf
ATOMIC_POSITIONS (crystal)
Cu 0.0 0.0 0.0
K_POINTS (automatic)
  16 16 16 0 0 0
