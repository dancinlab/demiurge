&CONTROL
  calculation='vc-relax'  prefix='SmCuAl'  outdir='./out/'  pseudo_dir='./pseudo/'
  verbosity='high'  tprnfor=.true.  tstress=.true.
  nstep=120  forc_conv_thr=1.0d-3  etot_conv_thr=1.0d-4
/
&SYSTEM
  ibrav=2  celldm(1)=12.30      ! half-Heusler (F-43m) SmCuAl, a~6.5 Ang in bohr (relax)
  nat=3  ntyp=3
  ecutwfc=80.0  ecutrho=320.0
  occupations='smearing' smearing='mv' degauss=0.02
  nspin=2
  starting_magnetization(1)=0.1   ! Sm (4f-in-core)
  starting_magnetization(2)=0.0   ! Cu (only 3d species — moment probe)
  starting_magnetization(3)=0.0   ! Al
/
&ELECTRONS
  electron_maxstep=400  mixing_mode='local-TF'  mixing_beta=0.3  conv_thr=1.0d-7
/
&IONS
/
&CELL
  cell_dofree='all'
/
ATOMIC_SPECIES
  Sm 150.36  Sm_4fcore_psl.UPF
  Cu  63.55  Cu_ONCV_PBE_sr.upf
  Al  26.98  Al_ONCV_PBE_sr.upf
ATOMIC_POSITIONS (crystal)
Sm 0.00 0.00 0.00
Cu 0.25 0.25 0.25
Al 0.50 0.50 0.50
K_POINTS (automatic)
  10 10 10 0 0 0
