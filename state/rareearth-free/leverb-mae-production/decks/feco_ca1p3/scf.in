&CONTROL
  calculation   = 'scf'
  prefix        = 'feco_ca1p3'
  outdir        = './out'
  pseudo_dir    = '../../pseudo'
  verbosity     = 'high'
  tprnfor       = .false.
  tstress       = .false.
/
&SYSTEM
  ibrav         = 0
  nat           = 2
  ntyp          = 2
  ecutwfc       = 60.0
  ecutrho       = 600.0
  occupations   = 'smearing'
  smearing      = 'mv'
  degauss       = 0.02
  noncolin      = .true.
  lspinorb      = .true.
  starting_magnetization(1) = 0.6
  starting_magnetization(2) = 0.4
  angle1(1)     = 0.0
  angle1(2)     = 0.0
  angle2(1)     = 0.0
  angle2(2)     = 0.0
/
&ELECTRONS
  conv_thr      = 1.0d-8
  mixing_beta   = 0.3
  electron_maxstep = 250
  diagonalization = 'david'
/
ATOMIC_SPECIES
  Fe  55.845  Fe.rel-pbe-spn-rrkjus_psl.0.2.1.UPF
  Co  58.933  Co.rel-pbe-spn-rrkjus_psl.0.3.1.UPF
CELL_PARAMETERS angstrom
  2.602179  0.000000  0.000000
  0.000000  2.602179  0.000000
  0.000000  0.000000  3.382833
ATOMIC_POSITIONS crystal
  Fe  0.000000  0.000000  0.000000
  Co  0.500000  0.500000  0.500000
K_POINTS automatic
  18 18 14  0 0 0
