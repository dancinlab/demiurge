&CONTROL
  calculation   = 'scf'
  prefix        = 'fe16n2'
  outdir        = './out'
  pseudo_dir    = '../../pseudo'
  verbosity     = 'high'
  tprnfor       = .false.
  tstress       = .false.
/
&SYSTEM
  ibrav         = 0
  nat           = 18
  ntyp          = 2
  ecutwfc       = 60.0
  ecutrho       = 600.0
  occupations   = 'smearing'
  smearing      = 'mv'
  degauss       = 0.02
  noncolin      = .true.
  lspinorb      = .true.
  starting_magnetization(1) = 0.5
  starting_magnetization(2) = 0.0
  angle1(1)     = 0.0
  angle2(1)     = 0.0
/
&ELECTRONS
  conv_thr      = 1.0d-8
  mixing_beta   = 0.3
  electron_maxstep = 250
  diagonalization = 'david'
/
ATOMIC_SPECIES
  Fe  55.845  Fe.rel-pbe-spn-rrkjus_psl.0.2.1.UPF
  N   14.007  N.pbe-n-rrkjus_psl.1.0.0.UPF
CELL_PARAMETERS angstrom
  5.720000  0.000000  0.000000
  0.000000  5.720000  0.000000
  0.000000  0.000000  6.290000
ATOMIC_POSITIONS crystal
  Fe  0.000000  0.500000  0.250000
  Fe  0.500000  0.000000  0.250000
  Fe  0.000000  0.500000  0.750000
  Fe  0.500000  0.000000  0.750000
  Fe  0.000000  0.000000  0.312500
  Fe  0.000000  0.000000  0.687500
  Fe  0.500000  0.500000  0.812500
  Fe  0.500000  0.500000  0.187500
  Fe  0.250000  0.250000  0.000000
  Fe  0.750000  0.750000  0.000000
  Fe  0.250000  0.750000  0.000000
  Fe  0.750000  0.250000  0.000000
  Fe  0.750000  0.750000  0.500000
  Fe  0.250000  0.250000  0.500000
  Fe  0.750000  0.250000  0.500000
  Fe  0.250000  0.750000  0.500000
  N  0.000000  0.000000  0.000000
  N  0.500000  0.500000  0.500000
K_POINTS automatic
  6 6 6  0 0 0
