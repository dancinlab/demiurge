&CONTROL
  calculation   = 'scf'
  prefix        = 'fecotet'
  outdir        = './out'
  pseudo_dir    = '../../pseudo'
  verbosity     = 'high'
/
&SYSTEM
  ibrav         = 0
  nat           = 2
  ntyp          = 2
  ecutwfc       = 60.0
  ecutrho       = 600.0
  occupations   = 'smearing'
  smearing      = 'mv'
  degauss       = 0.02
  noncolin      = .true.
  lspinorb      = .true.
  starting_magnetization(1) = 0.6
  starting_magnetization(2) = 0.6
  angle1(1)     = 0.0
  angle1(2)     = 0.0
/
&ELECTRONS
  conv_thr      = 1.0d-8
  mixing_beta   = 0.3
  electron_maxstep = 200
  diagonalization = 'david'
/
ATOMIC_SPECIES
  Fe  55.845  Fe.rel-pbe-spn-rrkjus_psl.0.2.1.UPF
  Co  58.933  Co.rel-pbe-spn-rrkjus_psl.0.3.1.UPF
CELL_PARAMETERS angstrom
  2.840  0.000  0.000
  0.000  2.840  0.000
  0.000  0.000  3.408
ATOMIC_POSITIONS crystal
  Fe  0.0  0.0  0.0
  Co  0.5  0.5  0.5
K_POINTS automatic
  14 14 12  0 0 0
