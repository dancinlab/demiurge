&CONTROL
  calculation   = 'scf'
  prefix        = 'feco'
  outdir        = './out'
  pseudo_dir    = '../../pseudo'
  verbosity     = 'high'
  tprnfor       = .false.
  tstress       = .false.
/
&SYSTEM
  ibrav         = 0
  nat           = 2
  ntyp          = 1
  ecutwfc       = 60.0
  ecutrho       = 600.0
  occupations   = 'smearing'
  smearing      = 'mv'
  degauss       = 0.02
  noncolin      = .true.
  lspinorb      = .true.
  starting_magnetization(1) = 0.4
  angle1(1)     = 0.0
  angle2(1)     = 0.0
/
&ELECTRONS
  conv_thr      = 1.0d-8
  mixing_beta   = 0.3
  electron_maxstep = 1
  diagonalization = 'david'
/
ATOMIC_SPECIES
  Fe  55.845  Fe.rel-pbe-spn-rrkjus_psl.0.2.1.UPF
CELL_PARAMETERS angstrom
  2.866  0.000  0.000
  0.000  2.866  0.000
  0.000  0.000  2.866
ATOMIC_POSITIONS crystal
  Fe  0.0  0.0  0.0
  Fe  0.5  0.5  0.5
K_POINTS automatic
  12 12 12  0 0 0
