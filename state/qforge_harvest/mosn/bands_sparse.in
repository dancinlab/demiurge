&control
  calculation = 'bands'
  prefix = 'mosn'
  outdir = './out'
  pseudo_dir = './pseudo'
/
&system
  ibrav = 4
  celldm(1) = 10.59396
  celldm(3) = 0.84778
  nat = 6
  ntyp = 2
  ecutwfc = 90
  ecutrho = 360
  nspin = 2
  starting_magnetization(1) = 0.0
  starting_magnetization(2) = 0.0
  occupations = 'smearing'
  smearing = 'mp'
  degauss = 0.02
  nbnd = 50
/
&electrons
  conv_thr = 1.0d-6
  diagonalization = 'david'
  diago_david_ndim = 4
  diago_full_acc = .false.
/
ATOMIC_SPECIES
  Mo 95.95   Mo_ONCV_PBE_sr.upf
  Sn 118.71  Sn_ONCV_PBE_sr.upf
ATOMIC_POSITIONS crystal
  Mo 0.500000 0.000000 0.000000
  Mo 0.000000 0.500000 0.000000
  Mo 0.500000 0.500000 0.000000
  Sn 0.000000 0.000000 0.000000
  Sn 0.333333 0.666667 0.500000
  Sn 0.666667 0.333333 0.500000
K_POINTS crystal_b
  5
  0.0000 0.0000 0.0000 12   ! Gamma
  0.3333 0.3333 0.0000 12   ! K
  0.5000 0.0000 0.0000 12   ! M
  0.0000 0.0000 0.0000 12   ! Gamma
  0.0000 0.0000 0.5000 1    ! A
